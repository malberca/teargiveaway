{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tear-sorteos",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
